    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "i18next": "^23.11.0",
    "jsdom": "30.1.3",
    "postcss": "^8.4.39",
    "react-i18next": "^14.1.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^6.4.4",
    "vitest": "5.0.5"
