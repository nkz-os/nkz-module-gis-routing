    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nekazari/design-tokens": "^0.1.0-alpha.0",
    "@nekazari/sdk": "^1.0.3",
    "@nekazari/ui-kit": "^1.0.2-alpha.4",
    "@nekazari/viewer-kit": "^0.1.1-alpha.0",
    "@turf/area": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/boolean-valid": "7.4.0",
    "@turf/buffer": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/point-on-feature": "7.4.0",
    "lucide-react": "^0.424.0",
    "maplibre-gl": "6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
